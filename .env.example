# Copie para .env (NÃO versionar) e exporte as variáveis antes de rodar o back-end
DB_URL=jdbc:postgresql://localhost:5432/learningscore
DB_USER=learningscore
DB_PASSWORD=troque_esta_senha
DEMO_ENABLED=true
COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost:8080
# Opcional (e-mail de confirmação de exclusão, RF12):
# SPRING_MAIL_HOST=smtp.exemplo.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=

# Avaliação de conteúdo: endereço público acessível ao professor (HTTPS em produção)
PUBLIC_BASE_URL=http://localhost:8080
AVALIACAO_VALIDADE_HORAS=72
# Configure o SMTP existente para convites e resultados:
# MAIL_FROM=Learning Score <nao-responder@seu-dominio.com>
# SMTP_AUTH=true
# SMTP_STARTTLS_ENABLE=true
# Para SMTP com SSL na porta 465, use as propriedades SSL do Spring Mail.
